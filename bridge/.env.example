# Copy to .env and fill in your values. Never commit .env or secrets/.
# Simple values such as HA_URL can be overridden by an EnvironmentFile.

# ---- Speech-to-text ----
# ha        Home Assistant Assist pipeline, any STT engine (Nabu Casa Cloud or local Whisper)
# nabucasa  Home Assistant Assist pipeline restricted to the Nabu Casa Cloud STT engine
# wyoming   Local Whisper server over the Wyoming protocol (HA Whisper add-on, 10300)
# openai    Any OpenAI-compatible /v1/audio/transcriptions endpoint (local or cloud)
# azure     Azure Speech short-audio REST API
STT_PROVIDER=ha
STT_LANGUAGE=zh-CN

# STT_PROVIDER=ha / nabucasa
HA_URL=http://homeassistant.local:8123
# HA_PIPELINE_ID=...
# HA_STT_ENGINE=cloud
# HA_TOKEN=...
HA_TOKEN_FILE=secrets/HA_TOKEN

# STT_PROVIDER=wyoming
# WYOMING_STT_HOST=127.0.0.1
# WYOMING_STT_PORT=10300
# WYOMING_STT_TIMEOUT=60

# STT_PROVIDER=openai
# OPENAI_STT_URL=http://127.0.0.1:8080/v1/audio/transcriptions
# OPENAI_STT_MODEL=whisper-1
# OPENAI_STT_API_KEY=...
# OPENAI_STT_KEY_FILE=secrets/OPENAI_STT_KEY

# STT_PROVIDER=azure
# AZURE_SPEECH_REGION=eastasia
# AZURE_SPEECH_ENDPOINT=https://your-resource.cognitiveservices.azure.com/stt/speech/recognition/conversation/cognitiveservices/v1
# AZURE_SPEECH_KEY=...
# AZURE_SPEECH_KEY_FILE=secrets/AZURE_SPEECH_KEY

MA_URL=http://music-assistant.local:8095
# MA_TOKEN=...
MA_TOKEN_FILE=secrets/MA_TOKEN
# MA_PLAYER_ID=...   # empty = auto-select the playing/paused/first usable player

DEEPSEEK_API_KEY_FILE=secrets/DEEPSEEK_API_KEY
# DEEPSEEK_API_KEY=...
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_URL=https://api.deepseek.com/v1/chat/completions

PORT=8096
# BRIDGE_TOKEN=change-me
# DEBUG_AUDIO=0
# LOG_LEVEL=INFO
